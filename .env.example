# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase.
# Estas dos claves son PÚBLICAS por diseño (la seguridad la dan las reglas RLS de la base de datos).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon_o_publishable

# Opcional: correo del editor principal. Si lo completás, la pantalla de acceso
# solo pide la contraseña (el correo NO es secreto; la contraseña nunca va acá).
VITE_EDITOR_EMAIL=
